FROM node:24-alpine3.24 AS api-tests-runner

RUN apk add --no-cache --virtual build-dependencies python3 g++ make

RUN apk add curl

RUN mkdir -p /var/www/api

ARG GITHUB_TOKEN
ENV GITHUB_TOKEN=${GITHUB_TOKEN}

COPY . /var/www/api
COPY .env.test /var/www/api/.env.test

WORKDIR /var/www/api

RUN yarn install --ignore-engines
RUN yarn build